rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.organizerId;
      
      // RSVPs subcollection
      match /rsvps/{rsvpId} {
        allow read: if true;
        allow write: if true; 
      }
    }
  }
}